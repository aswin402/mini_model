{
  "version": "1.0.0",
  "sandbox": {
    "timeout_seconds": 3.0,
    "max_memory_mb": 64,
    "max_repair_attempts": 3,
    "allowed_builtin_names": [
      "abs", "all", "any", "bool", "dict", "enumerate", "filter", "float",
      "int", "len", "list", "map", "max", "min", "range", "reversed",
      "round", "set", "sorted", "str", "sum", "tuple", "zip"
    ],
    "forbidden_ast_nodes": [
      "Import", "ImportFrom", "Delete", "Global", "Nonlocal"
    ],
    "forbidden_names": [
      "eval", "exec", "open", "input", "compile", "__import__", "globals", "locals"
    ]
  },
  "allowed_framing_words": [
    "write", "create", "generate", "synthesize", "implement", "build", "make", "give", "me",
    "please", "can", "could", "you", "a", "an", "the", "python", "code", "function", "program",
    "algorithm", "to", "for", "of", "in", "that", "which", "check", "determine", "test", "if",
    "whether", "is", "computes", "compute", "calculates", "calculate", "returns", "return",
    "number", "numbers", "integer", "integers", "non", "negative", "string", "strings", "list",
    "lists", "array", "arrays", "nested", "two", "dimensional", "2d", "element", "elements",
    "n", "s", "arr", "target"
  ],
  "algorithmic_primitives": {
    "factorial": {
      "name": "factorial",
      "params": ["n"],
      "trigger_tokens": ["factorial"],
      "docstring": "Compute the factorial of non-negative integer n.",
      "assertions": [
        "factorial(0) == 1",
        "factorial(1) == 1",
        "factorial(5) == 120",
        "factorial(6) == 720"
      ]
    },
    "fibonacci": {
      "name": "fibonacci",
      "params": ["n"],
      "trigger_tokens": ["fibonacci", "fib"],
      "docstring": "Compute the n-th Fibonacci number.",
      "assertions": [
        "fibonacci(0) == 0",
        "fibonacci(1) == 1",
        "fibonacci(7) == 13",
        "fibonacci(10) == 55"
      ]
    },
    "is_prime": {
      "name": "is_prime",
      "params": ["n"],
      "trigger_tokens": ["prime", "is_prime"],
      "docstring": "Return True if integer n is a prime number, else False.",
      "assertions": [
        "is_prime(1) == False",
        "is_prime(2) == True",
        "is_prime(13) == True",
        "is_prime(15) == False",
        "is_prime(97) == True"
      ]
    },
    "reverse_string": {
      "name": "reverse_string",
      "params": ["s"],
      "trigger_tokens": ["reverse", "reverse_string", "reversed"],
      "docstring": "Return the reversed string s.",
      "assertions": [
        "reverse_string('') == ''",
        "reverse_string('abc') == 'cba'",
        "reverse_string('little') == 'elttil'"
      ]
    },
    "is_palindrome": {
      "name": "is_palindrome",
      "params": ["s"],
      "trigger_tokens": ["palindrome", "is_palindrome"],
      "docstring": "Return True if s is a palindrome, ignoring non-alphanumeric and case.",
      "assertions": [
        "is_palindrome('racecar') == True",
        "is_palindrome('A man a plan a canal Panama') == True",
        "is_palindrome('hello') == False"
      ]
    },
    "gcd": {
      "name": "gcd",
      "params": ["a", "b"],
      "trigger_tokens": ["gcd"],
      "trigger_phrases": ["greatest common divisor"],
      "docstring": "Compute the Greatest Common Divisor of a and b using Euclidean algorithm.",
      "assertions": [
        "gcd(48, 18) == 6",
        "gcd(101, 103) == 1",
        "gcd(20, 100) == 20"
      ]
    },
    "sum_list": {
      "name": "sum_list",
      "params": ["numbers"],
      "trigger_tokens": ["sum", "sum_list"],
      "docstring": "Return the sum of all elements in list numbers.",
      "assertions": [
        "sum_list([]) == 0",
        "sum_list([1, 2, 3, 4]) == 10",
        "sum_list([-5, 5]) == 0"
      ]
    },
    "max_element": {
      "name": "max_element",
      "params": ["lst"],
      "trigger_tokens": ["max", "maximum", "max_element"],
      "docstring": "Return the maximum element in non-empty list lst.",
      "assertions": [
        "max_element([1]) == 1",
        "max_element([1, 9, 3, 7]) == 9",
        "max_element([-10, -5, -20]) == -5"
      ]
    },
    "binary_search": {
      "name": "binary_search",
      "params": ["arr", "target"],
      "trigger_tokens": ["binary_search"],
      "trigger_phrases": ["binary search"],
      "docstring": "Return the index of target in sorted arr, or -1 if not found.",
      "assertions": [
        "binary_search([1, 3, 5, 7, 9], 5) == 2",
        "binary_search([1, 3, 5, 7, 9], 1) == 0",
        "binary_search([1, 3, 5, 7, 9], 9) == 4",
        "binary_search([1, 3, 5, 7, 9], 4) == -1"
      ]
    },
    "flatten": {
      "name": "flatten",
      "params": ["nested_list"],
      "trigger_tokens": ["flatten"],
      "docstring": "Flatten a 2D list of lists into a 1D list.",
      "assertions": [
        "flatten([]) == []",
        "flatten([[1, 2], [3, 4]]) == [1, 2, 3, 4]",
        "flatten([['a'], ['b', 'c']]) == ['a', 'b', 'c']"
      ]
    }
  }
}
