{
  "format": "little.parser_semantic_policy.v1",
  "patterns": [
    {
      "name": "color",
      "pattern": "^what color is\\s+(.*?)$",
      "predicate_role": "color",
      "subject_groups": [1],
      "target_literal": "?",
      "validate_subject": false
    },
    {
      "name": "habitat",
      "pattern": "^where\\s+(?:(?:does|do)\\s+(.+?)\\s+live|(.+?)\\s+lives?)$",
      "predicate_role": "habitat",
      "subject_groups": [1, 2],
      "target_literal": "?"
    },
    {
      "name": "habitat_location",
      "pattern": "^where\\s+can\\s+(?:i|we|one)?\\s*(?:find|see)\\s+(.+)$",
      "predicate_role": "habitat",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "diet",
      "pattern": "^what\\s+(?:does|do)\\s+(.+?)\\s+eat$",
      "predicate_role": "diet",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "capability",
      "pattern": "^what\\s+can\\s+(.+?)\\s+do$",
      "predicate_role": "capability",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "capability_can",
      "pattern": "^can\\s+(.+)$",
      "predicate_role": "capability",
      "split_strategy": "known_subject_or_tail",
      "body_group": 1,
      "phase": "capability"
    },
    {
      "name": "capability_action_verb",
      "pattern": "^(?:does|do)\\s+(.+)$",
      "predicate_role": "capability",
      "split_strategy": "action_verb_tail",
      "body_group": 1,
      "phase": "capability"
    },
    {
      "name": "composition",
      "pattern": "^what\\s+(?:is|are)\\s+(.+?)\\s+made\\s+of$",
      "predicate_role": "composition",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "whole",
      "pattern": "^what\\s+(?:parts?\\s+)?(?:does|do)\\s+(.+?)\\s+have$",
      "predicate_role": "whole",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "purpose",
      "pattern": "^what\\s+(?:is|are)\\s+(.+?)\\s+used\\s+for$",
      "predicate_role": "purpose",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "causality_forward",
      "pattern": "^what\\s+(?:does|do)\\s+(.+?)\\s+cause$",
      "predicate_role": "causality",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "causality_reverse",
      "pattern": "^what\\s+causes\\s+(.+)$",
      "predicate_role": "causality",
      "subject_literal": "?",
      "target_groups": [1]
    },
    {
      "name": "properties",
      "pattern": "^what\\s+properties\\s+(?:does|do)\\s+(.+?)\\s+have$",
      "predicate_role": "property",
      "subject_groups": [1],
      "target_literal": "?"
    },
    {
      "name": "comparative",
      "pattern": "^(?:is|are)\\s+(.+?)\\s+(?:bigger\\s+than|larger\\s+than|greater\\s+than)\\s+(.+)$",
      "predicate": "larger_than",
      "subject_groups": [1],
      "target_groups": [2]
    },
    {
      "name": "why_not_is",
      "pattern": "^why\\s+(?:is|are)\\s+(.+?)\\s+not\\s+(?:(?:a|an|the)\\s+)?(.+)$",
      "predicate": "__why_not__",
      "subject_groups": [1],
      "target_groups": [2]
    },
    {
      "name": "why_not_cant",
      "pattern": "^why\\s+can['’]?t\\s+(.+?)\\s+be\\s+(?:(?:a|an|the)\\s+)?(.+)$",
      "predicate": "__why_not__",
      "subject_groups": [1],
      "target_groups": [2]
    },
    {
      "name": "why_is_a_direct",
      "pattern": "^why\\s+(?:is|are)\\s+(?:(?:a|an|the)\\s+)?(.+?)\\s+(?:a|an|the)\\s+(.+)$",
      "predicate": "__why_is_a__",
      "subject_groups": [1],
      "target_groups": [2]
    },
    {
      "name": "why_is_a_boundary",
      "pattern": "^why\\s+(?:is|are)\\s+(.+)$",
      "predicate": "__why_is_a__",
      "split_strategy": "known_concepts_or_valid_last_token",
      "body_group": 1,
      "phase": "why"
    },
    {
      "name": "taxonomy_article",
      "pattern": "^(?:is|are)\\s+(?:(?:a|an|the)\\s+)?(.+?)\\s+(?:a|an|the)\\s+(.+)$",
      "predicate_role": "taxonomy",
      "subject_groups": [1],
      "target_groups": [2],
      "validate_subject": false,
      "validate_target": false
    },
    {
      "name": "taxonomy_boundary",
      "pattern": "^(?:is|are)\\s+(.+)$",
      "predicate_role": "taxonomy",
      "split_strategy": "known_concepts_or_last_token",
      "body_group": 1,
      "phase": "taxonomy"
    }
  ]
}
