        "if n_val.is_integer() and math.isqrt(int(n_val)) ** 2 == int(n_val):",
        "    return math.isqrt(int(n_val))",
        "return round(math.sqrt(n_val), 6)"
      ],
      "description": "Exact computation of the square root of non-negative number n"
