      "name": "FIBONACCI",
      "parameters": ["n"],
      "code_lines": [
        "n_val = int(n)",
        "if n_val <= 0:",
        "    return 0",
        "if n_val == 1:",
        "    return 1",
        "a, b = 0, 1",
        "for _ in range(n_val):",
        "    a, b = b, a + b",
        "return a"
      ],
      "description": "Exact computation of the n-th Fibonacci number: Fib(n)"
