    {
      "name": "IS_PRIME",
      "parameters": ["n"],
      "code_lines": [
        "num = int(n)",
        "if num < 2:",
        "    return False",
        "if num in (2, 3):",
        "    return True",
        "if num % 2 == 0 or num % 3 == 0:",
        "    return False",
        "i = 5",
        "while i * i <= num:",
        "    if num % i == 0 or num % (i + 2) == 0:",
        "        return False",
        "    i += 6",
        "return True"
      ],
      "description": "Deterministic primality test for integer n"
    },
