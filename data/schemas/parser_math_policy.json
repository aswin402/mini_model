{
  "format": "little.parser_math_policy.v1",
  "patterns": [
    {
      "name": "symbolic_binary",
      "pattern": "^(?:(?:what\\s+is|calculate|solve|eval|evaluate)\\s+)?(\\d+(?:\\.\\d+)?)\\s*([\\+\\-\\*\\/\\^]|\\*\\*)\\s*(\\d+(?:\\.\\d+)?)$",
      "operator_group": 2,
      "skill_by_operator": {
        "+": "ADD",
        "-": "SUBTRACT",
        "*": "MULTIPLY",
        "/": "DIVIDE",
        "^": "POWER",
        "**": "POWER"
      },
      "argument_groups": [1, 3]
    },
    {
      "name": "word_binary",
      "pattern": "^(?:(?:what\\s+is|calculate|solve|eval|evaluate)\\s+)?(\\d+(?:\\.\\d+)?)\\s+(plus|minus|times|multiplied by|divided by|to the power of)\\s+(\\d+(?:\\.\\d+)?)$",
      "operator_group": 2,
      "skill_by_operator": {
        "plus": "ADD",
        "minus": "SUBTRACT",
        "times": "MULTIPLY",
        "multiplied by": "MULTIPLY",
        "divided by": "DIVIDE",
        "to the power of": "POWER"
      },
      "argument_groups": [1, 3]
    },
    {
      "name": "add",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?add\\s+(\\d+(?:\\.\\d+)?)\\s+(?:and|to)\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "ADD",
      "argument_groups": [1, 2]
    },
    {
      "name": "sum",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?(?:the\\s+)?(?:sum|total)\\s+of\\s+(\\d+(?:\\.\\d+)?)\\s+and\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "ADD",
      "argument_groups": [1, 2]
    },
    {
      "name": "multiply",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?multiply\\s+(\\d+(?:\\.\\d+)?)\\s+(?:by|and)\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "MULTIPLY",
      "argument_groups": [1, 2]
    },
    {
      "name": "product",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?(?:the\\s+)?product\\s+of\\s+(\\d+(?:\\.\\d+)?)\\s+and\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "MULTIPLY",
      "argument_groups": [1, 2]
    },
    {
      "name": "divide",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?divide\\s+(\\d+(?:\\.\\d+)?)\\s+by\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "DIVIDE",
      "argument_groups": [1, 2]
    },
    {
      "name": "subtract",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?subtract\\s+(\\d+(?:\\.\\d+)?)\\s+from\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "SUBTRACT",
      "argument_groups": [1, 2],
      "reverse_arguments": true
    },
    {
      "name": "factorial_word",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?(?:the\\s+)?factorial\\s+(?:of\\s+)?(\\d+)$",
      "skill": "FACTORIAL",
      "argument_groups": [1],
      "argument_names": ["n"]
    },
    {
      "name": "factorial_symbol",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?(\\d+)!$",
      "skill": "FACTORIAL",
      "argument_groups": [1],
      "argument_names": ["n"]
    },
    {
      "name": "fibonacci",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?(?:the\\s+)?(?:fibonacci|fib)\\s+(?:number\\s+)?(?:of\\s+|for\\s+)?(\\d+)$",
      "skill": "FIBONACCI",
      "argument_groups": [1],
      "argument_names": ["n"]
    },
    {
      "name": "prime_check_subject",
      "pattern": "^(?:is\\s+)?(\\d+)\\s+prime$",
      "skill": "IS_PRIME",
      "argument_groups": [1],
      "argument_names": ["n"]
    },
    {
      "name": "prime_check_prefix",
      "pattern": "^prime\\s+(\\d+)$",
      "skill": "IS_PRIME",
      "argument_groups": [1],
      "argument_names": ["n"]
    },
    {
      "name": "nth_prime",
      "pattern": "^(?:(?:what\\s+is|calculate|find)\\s+)?(?:the\\s+)?(\\d+)(?:st|nd|rd|th)\\s+prime(?:\\s+number)?$",
      "skill": "NTH_PRIME",
      "argument_groups": [1],
      "argument_names": ["n"]
    },
    {
      "name": "reverse_string",
      "pattern": "^(?:(?:what\\s+is|calculate)\\s+)?(?:the\\s+)?reverse\\s+(?:of\\s+)?['\"]?([^'\"]+)['\"]?$",
      "skill": "REVERSE_STRING",
      "argument_groups": [1],
      "argument_names": ["text"],
      "value_type": "text"
    },
    {
      "name": "palindrome_check",
      "pattern": "^(?:is\\s+)?['\"]?([^'\"]+?)['\"]?\\s+(?:a\\s+)?palindrome$",
      "skill": "PALINDROME",
      "argument_groups": [1],
      "argument_names": ["text"],
      "value_type": "text"
    },
    {
      "name": "square_named",
      "pattern": "^(?:(?:what\\s+is|calculate|find)\\s+)?(?:the\\s+)?square\\s+of\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "POWER",
      "argument_groups": [1],
      "argument_names": ["a"],
      "fixed_arguments": {"b": 2}
    },
    {
      "name": "square_suffix",
      "pattern": "^(\\d+(?:\\.\\d+)?)\\s+squared$",
      "skill": "POWER",
      "argument_groups": [1],
      "argument_names": ["a"],
      "fixed_arguments": {"b": 2}
    },
    {
      "name": "cube_named",
      "pattern": "^(?:(?:what\\s+is|calculate|find)\\s+)?(?:the\\s+)?cube\\s+of\\s+(\\d+(?:\\.\\d+)?)$",
      "skill": "POWER",
      "argument_groups": [1],
      "argument_names": ["a"],
      "fixed_arguments": {"b": 3}
    },
    {
      "name": "cube_suffix",
      "pattern": "^(\\d+(?:\\.\\d+)?)\\s+cubed$",
      "skill": "POWER",
      "argument_groups": [1],
      "argument_names": ["a"],
      "fixed_arguments": {"b": 3}
    },
    {
      "name": "average",
      "pattern": "^(?:(?:what\\s+is|calculate|find)\\s+)?(?:the\\s+)?(?:average|mean)\\s+(?:of\\s+)?((?:\\d+(?:\\.\\d+)?(?:,\\s*|\\s+and\\s+|\\s+))+\\d+(?:\\.\\d+)?)$",
      "skill": "AVERAGE",
      "argument_groups": [1],
      "argument_names": ["numbers"],
      "value_type": "numbers"
    },
    {
      "name": "linear_equation",
      "pattern": "^(?:solve\\s+)?(-?\\d+(?:\\.\\d+)?)\\s*\\*?\\s*x\\s*([+-])\\s*(\\d+(?:\\.\\d+)?)\\s*=\\s*(-?\\d+(?:\\.\\d+)?)$",
      "skill": "SOLVE_LINEAR",
      "captures": [
        {"group": 1, "name": "a", "value_type": "number", "normalizers": ["float"]},
        {"group": 2, "name": "sign", "value_type": "text", "include": false},
        {"group": 3, "name": "b", "value_type": "number", "normalizers": ["float"], "sign_group": 2},
        {"group": 4, "name": "c", "value_type": "number", "normalizers": ["float"]}
      ]
    },
    {
      "name": "quadratic_equation",
      "pattern": "^solve\\s+((?=.*(?:x\\^2|x\\*\\*2|x \\^ 2|x \\* \\* 2)).+)$",
      "skill": "SOLVE_QUADRATIC",
      "captures": [
        {"group": 1, "name": "equation", "value_type": "text"}
      ]
    },
    {
      "name": "derivative",
      "pattern": "^(?:(?:what\\s+is\\s+)?(?:the\\s+)?derivative\\s+of|diff(?:erentiate)?)\\s+([x0-9\\s+\\-*/^.()]+)$",
      "skill": "CALCULUS_DERIVATIVE",
      "captures": [
        {"group": 1, "name": "expression", "value_type": "text"}
      ]
    },
    {
      "name": "simplification",
      "pattern": "^(?:(?:can\\s+you\\s+)?simplify)\\s+([x0-9\\s+\\-*/^.()]+)$",
      "skill": "SIMPLIFY_EXPR",
      "captures": [
        {"group": 1, "name": "expression", "value_type": "text"}
      ]
    },
    {
      "name": "unit_conversion",
      "pattern": "^(?:convert\\s+)?(\\d+(?:\\.\\d+)?)\\s+([a-zA-Z]+)\\s+(?:to|in|into)\\s+([a-zA-Z]+)$",
      "skill": "UNIT_CONVERT",
      "captures": [
        {"group": 1, "name": "value", "value_type": "number"},
        {"group": 2, "name": "from_unit", "value_type": "text", "normalizers": ["lower"]},
        {"group": 3, "name": "to_unit", "value_type": "text", "normalizers": ["lower"]}
      ]
    },
    {
      "name": "numeric_expression",
      "pattern": "^(?:(?:what\\s+is|calculate|compute|evaluate)\\s+)?\\s*(\\(?\\s*\\d+(?:\\.\\d+)?\\s*(?:[+\\-*/^]|(?:\\*\\*))\\s*[-+*/()0-9\\s.^]+)$",
      "skill": "EVAL_EXPR",
      "captures": [
        {"group": 1, "name": "expression", "value_type": "text", "normalizers": ["caret_to_power"]}
      ]
    }
  ]
}
